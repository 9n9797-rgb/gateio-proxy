# ===== مفاتيح Gate.io (مطلوبة للتداول الحقيقي وقراءة الأرصدة) =====
GATEIO_API_KEY=
GATEIO_API_SECRET=

PORT=4000

# ===== الذكاء الصناعي الاختياري (LLM) فوق محرك القرار الكمّي =====
# إن تُرك فارغاً يعمل النظام بالمحرك الكمّي فقط (RSI/MACD/MA/OBV + تعلّم من النتائج)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== إعدادات الأوتوبايلوت =====
# off | signal | paper | live
AUTOPILOT_PAIRS=BTC_USDT,ETH_USDT
AUTOPILOT_INTERVAL_MS=60000

# حماية إلزامية: لا يمكن تفعيل وضع "live" (تداول حقيقي) إلا بضبطها على true عمداً
AUTOPILOT_ALLOW_LIVE=false

# رأس المال الافتراضي للمحفظة الوهمية (Paper Trading)
PAPER_START_BALANCE=10000

# تقدير تقريبي لرأس المال الحقيقي بالـ USDT (يُستخدم لحساب حجم الصفقة في وضع live)
LIVE_EQUITY_ESTIMATE_USDT=1000

# ===== إدارة المخاطر (شبكة أمان ثابتة فوق قرار الذكاء الصناعي) =====
RISK_PER_TRADE_PCT=2
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=10
MAX_DAILY_LOSS_PCT=5
