# ===== مفاتيح Gate.io للوضع القديم أحادي المستخدم (نقاط /proxy/* فقط) =====
GATEIO_API_KEY=
GATEIO_API_SECRET=

PORT=4000

# ===== مفتاح التشفير الرئيسي (إلزامي قبل أي استخدام لميزات المستخدمين المتعددين) =====
# يُستخدم لتشفير مفاتيح Gate.io الخاصة بكل مستخدم داخل قاعدة البيانات.
# أنشئه بالأمر: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# ===== إرسال رمز استعادة كلمة السر بالبريد =====
# إن تُركت فارغة، يُطبع الرمز في سجل الخادم فقط (للتجربة المحلية، غير صالح للإنتاج)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ===== الذكاء الصناعي الاختياري (LLM) فوق محرك القرار الكمّي =====
# إن تُرك فارغاً يعمل النظام بالمحرك الكمّي فقط (RSI/MACD/MA/OBV + تعلّم من النتائج)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===== إعدادات الأوتوبايلوت =====
AUTOPILOT_INTERVAL_MS=60000

# حماية إلزامية: لا يمكن لأي مستخدم تفعيل وضع "live" (تداول حقيقي) إلا بضبطها على true عمداً
AUTOPILOT_ALLOW_LIVE=false

# رأس المال الافتراضي للمحفظة الوهمية (Paper Trading) لكل مستخدم جديد
PAPER_START_BALANCE=10000

# تقدير تقريبي لرأس المال الحقيقي بالـ USDT (يُستخدم لحساب حجم الصفقة في وضع live)
LIVE_EQUITY_ESTIMATE_USDT=1000

# ===== لوحة الأدمن =====
# بريد/بريد (مفصول بفواصل) يُمنح صلاحية الوصول لـ /app/admin.html و /admin/*
# الدخول يتم بنفس نظام رمز البريد العادي — لا توجد كلمة مرور أدمن منفصلة
ADMIN_EMAILS=

# ===== إدارة المخاطر (شبكة أمان ثابتة فوق قرار الذكاء الصناعي، تنطبق على الجميع) =====
RISK_PER_TRADE_PCT=2
STOP_LOSS_PCT=1.5
TAKE_PROFIT_PCT=3
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=10
MAX_DAILY_LOSS_PCT=5
